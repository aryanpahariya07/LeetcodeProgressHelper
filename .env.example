# Copy to apps/api/.env for local development. Never commit real secrets.

# --- storage -------------------------------------------------------------
# SQLite locally; the schema is Postgres-compatible, so moving is a URL change.
DATABASE_URL=sqlite+aiosqlite:///./dsa_coach.db

# --- auth ----------------------------------------------------------------
# Bootstrap secret authorising the extension pairing flow (spec §5).
# Server-only: never shipped to the web app or the extension.
# Phase 2 uses it to mint revocable, hashed, scoped device tokens.
APP_SECRET=dev-only-change-me

# --- web -----------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173

# --- ingestion limits ----------------------------------------------------
MAX_BATCH_SIZE=100
MAX_REQUEST_BYTES=1048576

LOG_LEVEL=INFO

# --- runtime coach (Phase 4) ---------------------------------------------
# The OpenAI key never leaves the server, and is never in the web bundle or
# the extension.
#
# Leaving it unset is a supported configuration, not a broken one: the coach
# falls back to a deterministic runtime and the product keeps working
# (invariant 4). Only the AI's judgment is lost, never the scheduler.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_TRACING_ENABLED=false
