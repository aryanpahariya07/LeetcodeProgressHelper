# Copy to apps/api/.env for local development. Never commit real secrets.

# --- storage -------------------------------------------------------------
# SQLite locally; the schema is Postgres-compatible, so moving is a URL change.
DATABASE_URL=sqlite+aiosqlite:///./dsa_coach.db

# --- auth ----------------------------------------------------------------
# Bootstrap secret authorising the extension pairing flow (spec §5).
# Server-only: never shipped to the web app or the extension.
# Phase 2 uses it to mint revocable, hashed, scoped device tokens.
APP_SECRET=dev-only-change-me

# --- web -----------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173

# --- ingestion limits ----------------------------------------------------
MAX_BATCH_SIZE=100
MAX_REQUEST_BYTES=1048576

LOG_LEVEL=INFO

# --- not used until later phases ----------------------------------------
# Runtime coach provider (Phase 4). The OpenAI key never leaves the server.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AGENT_TRACING_ENABLED=false
